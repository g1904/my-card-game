{
  "statusLine": {
    "type": "command",
    "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/statusline.sh\"",
    "padding": 1
  },
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "allow": [
      "Bash",
      "Edit",
      "Write",
      "Read",
      "Glob",
      "Grep",
      "WebFetch",
      "WebSearch",
      "TodoWrite",
      "Skill"
    ],
    "deny": [
      "Edit(game-testing-branch/**)",
      "Edit(game-production-branch/**)",
      "Edit(backend-testing-branch/**)",
      "Edit(backend-production-branch/**)"
    ],
    "defaultMode": "bypassPermissions"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/check-bash-readonly-dir.sh\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"D:\\MyCardGame\\.claude\\scripts\\index-size-guard.ps1\""
          }
        ]
      }
    ]
  },
  "model": "claude-opus-5",
  "effortLevel": "medium",
  "outputStyle": "default"
}
